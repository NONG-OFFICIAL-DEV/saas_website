# Nuxt runtime config (see nuxt.config.ts's runtimeConfig.public) — unlike
# the old Vite app's VITE_APP_* build-time vars, these are read at container
# start, so the same built image works across environments without a rebuild.
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/
NUXT_PUBLIC_ADMIN_APP_URL=https://admin.nexstacktech.com
NUXT_PUBLIC_CMS_API_URL=http://127.0.0.1:8001/api/v1
NUXT_PUBLIC_STUDIO_API_URL=http://127.0.0.1:8001/api/v1
NUXT_PUBLIC_STUDIO_APP_URL=https://photo-studio.nexstacktech.com
